{
  "uid": "fusion-ml-shadow",
  "title": "Fusion Route-aware ML Shadow Monitoring",
  "tags": [
    "fusion",
    "route-aware-ml",
    "shadow-only"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 6,
  "refresh": "10s",
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ml_verdict",
        "label": "ML events",
        "type": "custom",
        "query": "Anomaly : true,Normal : false",
        "current": {
          "text": "Anomaly",
          "value": "true"
        },
        "options": [
          {
            "text": "Anomaly",
            "value": "true",
            "selected": true
          },
          {
            "text": "Normal",
            "value": "false",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Candidate coverage by route",
      "description": "Completed ML shadow events divided by Detection API inspections; candidates remain shadow-only. Click a point and choose View source events to open the logs in the same route and lookback interval. Percentiles summarize multiple source events.",
      "datasource": {
        "type": "loki",
        "uid": "fusion-loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (route) (count_over_time({job=\"fusion-ml-shadow\",event_type=\"shadow_completed\"} [$__interval])) / sum by (route) (count_over_time({job=\"fusion-detector\",event_type=\"inspection\",route=~\"query|xfh|utm|fatget\"} [$__interval]))",
          "legendFormat": "{{route}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View ${ml_verdict:text} completed ML events for ${__field.labels.route}",
                    "url": "/explore?schemaVersion=1&panes=%7B%22logs%22%3A%7B%22datasource%22%3A%22fusion-loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bjob%3D%5C%22fusion-ml-shadow%5C%22%2Cevent_type%3D%5C%22shadow_completed%5C%22%2Croute%3D%5C%22${__field.labels.route}%5C%22%7D%20%7C%20json%20%7C%20final_anomaly%3D%5C%22${ml_verdict:raw}%5C%22%20%7C%20label_format%20point_age_ms%3D%60%7B%7B%20sub%20${__value.time}%20%28unixEpochMillis%20%28__timestamp__%29%29%20%7D%7D%60%20%7C%20point_age_ms%20%3E%3D%200%20%7C%20point_age_ms%20%3C%20${__interval_ms}%22%2C%22queryType%22%3A%22range%22%2C%22editorMode%22%3A%22code%22%2C%22direction%22%3A%22backward%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22fusion-loki%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__value.time}%22%7D%2C%22compact%22%3Afalse%7D%7D&orgId=1",
                    "targetBlank": true
                  },
                  {
                    "title": "View detector inspections for ${__field.labels.route}",
                    "url": "/explore?schemaVersion=1&panes=%7B%22logs%22%3A%7B%22datasource%22%3A%22fusion-loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bjob%3D%5C%22fusion-detector%5C%22%2Cevent_type%3D%5C%22inspection%5C%22%2Croute%3D%5C%22${__field.labels.route}%5C%22%7D%20%7C%20json%20%7C%20label_format%20point_age_ms%3D%60%7B%7B%20sub%20${__value.time}%20%28unixEpochMillis%20%28__timestamp__%29%29%20%7D%7D%60%20%7C%20point_age_ms%20%3E%3D%200%20%7C%20point_age_ms%20%3C%20${__interval_ms}%22%2C%22queryType%22%3A%22range%22%2C%22editorMode%22%3A%22code%22%2C%22direction%22%3A%22backward%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22fusion-loki%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__value.time}%22%7D%2C%22compact%22%3Afalse%7D%7D&orgId=1",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "IF / profile / final anomaly rate by route",
      "description": "Candidate assessment only; these values never control cache behavior. Click a point and choose View anomaly logs to open Explore for that route and decision over the same lookback interval ending at the selected point. ML events selector filters drilldown logs by the selected IF/Profile/Final verdict; plotted rates are unchanged.",
      "datasource": {
        "type": "loki",
        "uid": "fusion-loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (route) (count_over_time({job=\"fusion-ml-shadow\",event_type=\"shadow_completed\"} | json | if_anomaly=\"true\" [$__interval])) / sum by (route) (count_over_time({job=\"fusion-ml-shadow\",event_type=\"shadow_completed\"} [$__interval]))",
          "legendFormat": "IF {{route}}",
          "queryType": "range"
        },
        {
          "refId": "B",
          "expr": "100 * sum by (route) (count_over_time({job=\"fusion-ml-shadow\",event_type=\"shadow_completed\"} | json | profile_anomaly=\"true\" [$__interval])) / sum by (route) (count_over_time({job=\"fusion-ml-shadow\",event_type=\"shadow_completed\"} [$__interval]))",
          "legendFormat": "Profile {{route}}",
          "queryType": "range"
        },
        {
          "refId": "C",
          "expr": "100 * sum by (route) (count_over_time({job=\"fusion-ml-shadow\",event_type=\"shadow_completed\"} | json | final_anomaly=\"true\" [$__interval])) / sum by (route) (count_over_time({job=\"fusion-ml-shadow\",event_type=\"shadow_completed\"} [$__interval]))",
          "legendFormat": "Final {{route}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
