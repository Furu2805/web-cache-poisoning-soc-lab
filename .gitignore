# Python and local tooling
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.runtime/
node_modules/
.git/

# Local credentials and environment overrides
.env
.env.*
!.env.triage.example

# Runtime data and generated results
data/*
!data/.gitkeep
!data/events/
data/events/*
!data/events/.gitkeep
!data/reports/
data/reports/*
!data/reports/.gitkeep
results/
MANIFEST_SHA256.json

# Current runtime models are explicit exceptions; legacy models stay local
models/*.joblib
!models/isolation_forest.joblib
!models/isolation_forest_detector_v2.joblib
models/candidates/
models/model_metadata.json

# Only registry-referenced ML artifacts are kept
ml-detector/data/
ml-detector/artifacts/*
!ml-detector/artifacts/candidates/
ml-detector/artifacts/candidates/*
!ml-detector/artifacts/candidates/query_phase2_v8/
!ml-detector/artifacts/candidates/xfh_phase1_v3/
!ml-detector/artifacts/candidates/utm_phase3/
!ml-detector/artifacts/candidates/fatget_phase4_v2/
ml-detector/artifacts/runtime_replay_v1/
# Historical candidate evaluation output is local-only until it has a complete
# reproducible run manifest (commit, host/resources, concurrency, sample counts).
ml-detector/artifacts/candidates/*/evaluation.json
ml-detector/artifacts/candidates/*/EVIDENCE.md
ml-detector/artifacts/candidates/*/dataset_manifest.json
ml-detector/artifacts/candidates/*/manifest.json
ml-detector/artifacts/candidates/*/train_normal_variance_audit.json

# Keep the public docs set curated; local coursework/archive stays out
docs/*
!docs/architecture.svg
!docs/FULL_DEMO_GUIDE.md
!docs/SOURCES.md
!docs/EVALUATION.md
!docs/SHADOW_RUNTIME.md
!docs/grafana-dashboard.png
docs/UPGRADE_CHECKLIST.md
docs/OPERATOR_GUIDE.local.md

