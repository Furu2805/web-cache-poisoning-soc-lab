# Copy this file to .env.triage and enter the key only on the local machine.
# .env.triage is ignored by Git. Never commit or paste a real key into reports.
TRIAGE_LLM_PROVIDER=zai-chat-completions
TRIAGE_LLM_REQUIRED=false
TRIAGE_LLM_TIMEOUT_SECONDS=30
TRIAGE_ZAI_MODEL=glm-5.3-flash
TRIAGE_ZAI_MAX_TOKENS=2048
TRIAGE_ZAI_REASONING_EFFORT=low
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_API_KEY=replace-with-local-zai-api-key
